# Copie para .env (cp .env.example .env) — configuracao para XAMPP local.
# MySQL do XAMPP: usuario root, sem senha. O banco e criado automaticamente.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafofo_do_pet
# Coloque true apenas em bancos gerenciados que exigem TLS (ex: Aiven)
DB_SSL=false

PORT=3333
JWT_SECRET=dev-secret-local
ADMIN_DEFAULT_PASSWORD=admin123
